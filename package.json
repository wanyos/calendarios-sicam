{
  "name": "calendarios-sicam",
  "version": "1.0.0",
  "description": "Calendarios de turnos por categoría y grupo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:wl": "vite --mode whitelabel",
    "build": "vite build",
    "build:wl": "vite build --mode whitelabel",
